     VdecPic* q = &v->queue[v->qHead];
     v->qHead = (v->qHead + 1) % VDEC_QUEUE;
     v->qCount--;
+    /* VDEC_DBG=<N>: where the first N pictures go and whether they hold an
+     * image (mean luma/chroma of the decoded frame; 16/128/128 is black). */
+    { static int cap = -1, n = 0;
+      if (cap < 0) { const char* e = getenv("VDEC_DBG"); cap = e ? atoi(e) : 0; }
+      if (cap && (n < cap || (n % 100) == 0)) {
+          u32 w = q->item.width, h = q->item.height, cw = (w + 1) / 2;
+          unsigned long long sy = 0, su = 0; u32 ny = 0, nu = 0;
+          if (q->yuv && w && h) {
+              for (u32 i = 0; i < w * h; i += 997) { sy += q->yuv[i]; ny++; }
+              for (u32 i = 0; i < cw * ((h + 1) / 2); i += 499) { su += q->yuv[w * h + i]; nu++; }
+          }
+          printf("[VDEC] pic #%d %ux%u -> dst=0x%08X fmt=%u alpha=%u meanY=%llu meanU=%llu q=%u\n",
+                 n, w, h, dst, type, alpha, ny ? sy / ny : 0ull, nu ? su / nu : 0ull, v->qCount);
+      }
+      n++; }
+    /* VDEC_SAVE=<every>: write every <every>-th decoded picture as a greyscale
+     * BMP (luma) to vdec_NNNN.bmp in the working directory -- the ground truth
+     * to hold a screen capture against. */
+    { static int every = -1, k = 0;
+      if (every < 0) { const char* e = getenv("VDEC_SAVE"); every = e ? atoi(e) : 0; }
+      if (every > 0 && (k++ % every) == 0 && q->yuv) {
+          u32 w = q->item.width, h = q->item.height;
+          char name[64]; snprintf(name, sizeof name, "logs/vdec_%04d.bmp", k - 1);
+          FILE* f = fopen(name, "wb");
+          if (f && w && h) {
+              u32 rb = (w * 3 + 3) & ~3u, sz = 54 + rb * h;
+              u8 hd[54] = {'B','M'};
+              hd[2]=(u8)sz; hd[3]=(u8)(sz>>8); hd[4]=(u8)(sz>>16); hd[5]=(u8)(sz>>24);
+              hd[10]=54; hd[14]=40;
+              hd[18]=(u8)w; hd[19]=(u8)(w>>8); hd[22]=(u8)h; hd[23]=(u8)(h>>8);
+              hd[26]=1; hd[28]=24;
+              fwrite(hd, 1, 54, f);
+              u8* row = (u8*)calloc(1, rb);
+              for (u32 y = 0; y < h && row; y++) {
+                  const u8* src = q->yuv + (size_t)(h - 1 - y) * w;
+                  for (u32 x = 0; x < w; x++) row[x*3] = row[x*3+1] = row[x*3+2] = src[x];
+                  fwrite(row, 1, rb, f);
+              }
+              free(row);
+          }
+          if (f) fclose(f);
+      } }
+    /* TRACE_AT_PIC=<pic>,<count>: at that picture, trace the next <count>
+     * FIFO methods (cellGcmSys [mtrace]) -- what a frame of playback draws. */
+    { static int at = -2, cnt = 0, seen = 0;
+      if (at == -2) { const char* e = getenv("TRACE_AT_PIC"); at = -1;
+                      if (e && sscanf(e, "%d,%d", &at, &cnt) != 2) at = -1; }
+      extern volatile int g_rfom_trace_left;
+      if (at >= 0 && seen++ == at) {
+          printf("[mtrace] armed at picture %d for %d methods\n", at, cnt);
+          g_rfom_trace_left = cnt;
+      } }
     if (dst)                                           /* NULL: a skip */
         vdec_store_picture(dst, q->yuv, q->item.width, q->item.height,
                            type, matrix, alpha);
