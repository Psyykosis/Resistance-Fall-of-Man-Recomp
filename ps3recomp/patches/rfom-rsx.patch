+/* ===========================================================================
+ * Resistance port: SPU job differential test (SPU_DIFFTEST=<every Nth job>).
+ *
+ * Fall of Man's freezes and its missing/ghost geometry both trace to WWS job
+ * modules handing back impossible values. To find the instruction the lifter
+ * gets wrong, a sampled job is run TWICE from the same starting state: first
+ * through the interpreter (dry: its PUTs are recorded, not written), then
+ * through the lifted code as normal. At the job's return the two local stores,
+ * register files and PUT streams are compared, and the first differences are
+ * written to logs\difftest.txt. The interpreter is the oracle-tested path.
+ * SPU_DIFFTEST_OVL=<id> restricts it to one job module (overlay image id).
+ * ===========================================================================*/
+typedef struct {
+    uint32_t n; uint64_t h;
+    uint32_t ea[64], sz[64]; uint64_t eh[64];
+} spu_putrec_t;
+SPU_THREAD_LOCAL void* g_spu_putrec = 0;
+SPU_THREAD_LOCAL int   g_spu_dry_put = 0;
+
+/* Dry-run shadow of atomically written lines (see spu_mfc_atomic). */
+typedef struct { uint32_t ea; uint8_t d[128]; } spu_dryline_t;
+static SPU_THREAD_LOCAL spu_dryline_t* t_dry = 0;
+static SPU_THREAD_LOCAL int t_dry_n = 0;
+int spu_dryshadow_get(uint32_t ea, uint8_t* out)
+{ for (int i = 0; i < t_dry_n; i++) if (t_dry[i].ea == ea) { memcpy(out, t_dry[i].d, 128); return 1; } return 0; }
+void spu_dryshadow_put(uint32_t ea, const uint8_t* in)
+{
+    if (!t_dry) t_dry = (spu_dryline_t*)calloc(64, sizeof *t_dry);
+    if (!t_dry) return;
+    for (int i = 0; i < t_dry_n; i++) if (t_dry[i].ea == ea) { memcpy(t_dry[i].d, in, 128); return; }
+    if (t_dry_n < 64) { t_dry[t_dry_n].ea = ea; memcpy(t_dry[t_dry_n].d, in, 128); t_dry_n++; }
+}
+static void spu_dryshadow_clear(void) { t_dry_n = 0; }
+
+static uint64_t dt_fnv(uint64_t h, const uint8_t* p, uint32_t n)
+{ for (uint32_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ull; } return h; }
+
+void spu_putrec_note(uint32_t ea, const uint8_t* src, uint32_t size)
+{
+    spu_putrec_t* r = (spu_putrec_t*)g_spu_putrec;
+    if (!r) return;
+    uint64_t eh = dt_fnv(14695981039346656037ull, src, size);
+    eh ^= ((uint64_t)ea << 32) ^ size;
+    if (r->n < 64) { r->ea[r->n] = ea; r->sz[r->n] = size; r->eh[r->n] = eh; }
+    r->n++;
+    r->h = r->h * 31u + eh;
+}
